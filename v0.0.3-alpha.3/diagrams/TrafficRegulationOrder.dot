// Diagram for TrafficRegulationOrder
digraph {
	graph [overlap=false rankdir=TB splines=true]
	node [fontname=Arial fontsize=12 margin=0 shape=none]
	edge [fontname=Arial fontsize=11]
	{
		rank=source
		"its-core_OfficialThing" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD BGCOLOR="lightgray" ALIGN="CENTER">its-core:OfficialThing</TD></TR></TABLE>> URL="https://w3id.org/itsdata/core/v1/OfficialThing" margin=0]
