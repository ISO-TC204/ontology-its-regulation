// Diagram for PermitRequiredCondition
digraph {
	graph [overlap=false rankdir=TB splines=true]
	node [fontname=Arial fontsize=12 margin=0 shape=none]
	edge [fontname=Arial fontsize=11]
	{
		rank=source
		Condition [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD BGCOLOR="lightgray" ALIGN="CENTER">Condition</TD></TR></TABLE>> URL="../Condition" margin=0]
	}
	PermitRequiredCondition [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD BGCOLOR="lightgray" ALIGN="CENTER">PermitRequiredCondition</TD></TR></TABLE>> URL="../PermitRequiredCondition" margin=0]
	{
		rank=max
	}
	subgraph cluster_associated {
		label="" style=invis
		Invis [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD></TD></TR></TABLE>> margin=0 style=invis]
		PermitDesignationCode [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD BGCOLOR="lightgray" ALIGN="CENTER">PermitDesignationCode</TD></TR></TABLE>> URL="../PermitDesignationCode" margin=0]
	}
	PermitRequiredCondition -> Condition [arrowhead=onormal style=solid]
	PermitRequiredCondition -> Invis [style=invis]
	Invis -> PermitDesignationCode [style=invis]
	PermitDesignationCode [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD BGCOLOR="lightgray" ALIGN="CENTER">PermitDesignationCode</TD></TR></TABLE>> URL="../PermitDesignationCode" margin=0]
	PermitRequiredCondition -> PermitDesignationCode [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white"><TR><TD ALIGN="CENTER">requiredDesignation</TD></TR></TABLE>> arrowhead=normal style=solid]
}
