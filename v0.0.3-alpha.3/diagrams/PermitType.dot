// Diagram for PermitType
digraph {
	graph [overlap=false rankdir=TB splines=true]
	node [fontname=Arial fontsize=12 margin=0 shape=none]
	edge [fontname=Arial fontsize=11]
	{
		rank=source
		RegulationThing [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD BGCOLOR="lightgray" ALIGN="CENTER">RegulationThing</TD></TR></TABLE>> URL="../RegulationThing" margin=0]
	}
	PermitType [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD BGCOLOR="lightgray" ALIGN="CENTER">PermitType</TD></TR><TR><TD ALIGN="LEFT">cdm1:hasDescription : rdf:langString [0..*]¹</TD></TR></TABLE>> URL="../PermitType" margin=0]
	{
		rank=max
	}
	subgraph cluster_associated {
		label="" style=invis
		Invis [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD></TD></TR></TABLE>> margin=0 style=invis]
		cdm2_Organization [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD BGCOLOR="lightgray" ALIGN="CENTER">cdm2:Organization</TD></TR></TABLE>> URL="https://w3id.org/citydata/part2/v1/Organization" margin=0]
		"its-location_Feature" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD BGCOLOR="lightgray" ALIGN="CENTER">its-location:Feature</TD></TR></TABLE>> URL="https://w3id.org/itsdata/location/v1/Feature" margin=0]
		"its-time_Duration" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD BGCOLOR="lightgray" ALIGN="CENTER">its-time:Duration</TD></TR></TABLE>> URL="https://w3id.org/itsdata/time/v1/Duration" margin=0]
		PermitApplicationInformation [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD BGCOLOR="lightgray" ALIGN="CENTER">PermitApplicationInformation</TD></TR></TABLE>> URL="../PermitApplicationInformation" margin=0]
		PermitDesignationCode [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD BGCOLOR="lightgray" ALIGN="CENTER">PermitDesignationCode</TD></TR></TABLE>> URL="../PermitDesignationCode" margin=0]
		PermitDisplayTypeCode [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD BGCOLOR="lightgray" ALIGN="CENTER">PermitDisplayTypeCode</TD></TR></TABLE>> URL="../PermitDisplayTypeCode" margin=0]
		PermitGranteeTypeCode [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD BGCOLOR="lightgray" ALIGN="CENTER">PermitGranteeTypeCode</TD></TR></TABLE>> URL="../PermitGranteeTypeCode" margin=0]
	}
	PermitType -> RegulationThing [arrowhead=onormal style=solid]
	PermitType -> Invis [style=invis]
	Invis -> cdm2_Organization [style=invis]
	cdm2_Organization -> "its-location_Feature" [style=invis]
	"its-location_Feature" -> "its-time_Duration" [style=invis]
	"its-time_Duration" -> PermitApplicationInformation [style=invis]
	PermitApplicationInformation -> PermitDesignationCode [style=invis]
	PermitDesignationCode -> PermitDisplayTypeCode [style=invis]
	PermitDisplayTypeCode -> PermitGranteeTypeCode [style=invis]
	PermitDesignationCode [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD BGCOLOR="lightgray" ALIGN="CENTER">PermitDesignationCode</TD></TR></TABLE>> URL="../PermitDesignationCode" margin=0]
	PermitType -> PermitDesignationCode [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white"><TR><TD ALIGN="CENTER">grantsDesignation</TD></TR><TR><TD ALIGN="CENTER">1</TD></TR></TABLE>> arrowhead=normal style=solid]
	cdm2_Organization [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD BGCOLOR="lightgray" ALIGN="CENTER">cdm2:Organization</TD></TR></TABLE>> URL="https://w3id.org/citydata/part2/v1/Organization" margin=0]
	PermitType -> cdm2_Organization [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white"><TR><TD ALIGN="CENTER">hasGrantor</TD></TR><TR><TD ALIGN="CENTER">1</TD></TR></TABLE>> arrowhead=normal style=solid]
	PermitApplicationInformation [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD BGCOLOR="lightgray" ALIGN="CENTER">PermitApplicationInformation</TD></TR></TABLE>> URL="../PermitApplicationInformation" margin=0]
	PermitType -> PermitApplicationInformation [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white"><TR><TD ALIGN="CENTER">hasApplicationInformation</TD></TR><TR><TD ALIGN="CENTER">0..1</TD></TR></TABLE>> arrowhead=normal style=solid]
	"its-time_Duration" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD BGCOLOR="lightgray" ALIGN="CENTER">its-time:Duration</TD></TR></TABLE>> URL="https://w3id.org/itsdata/time/v1/Duration" margin=0]
	PermitType -> "its-time_Duration" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white"><TR><TD ALIGN="CENTER">hasDefaultDurationLimit</TD></TR><TR><TD ALIGN="CENTER">0..1</TD></TR></TABLE>> arrowhead=normal style=solid]
	"its-location_Feature" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD BGCOLOR="lightgray" ALIGN="CENTER">its-location:Feature</TD></TR></TABLE>> URL="https://w3id.org/itsdata/location/v1/Feature" margin=0]
	PermitType -> "its-location_Feature" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white"><TR><TD ALIGN="CENTER">hasDefaultLocation</TD></TR><TR><TD ALIGN="CENTER">0..1</TD></TR></TABLE>> arrowhead=normal style=solid]
	PermitType -> "its-time_Duration" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white"><TR><TD ALIGN="CENTER">hasDefaultRepeatInterval</TD></TR><TR><TD ALIGN="CENTER">0..1</TD></TR></TABLE>> arrowhead=normal style=solid]
	PermitDisplayTypeCode [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD BGCOLOR="lightgray" ALIGN="CENTER">PermitDisplayTypeCode</TD></TR></TABLE>> URL="../PermitDisplayTypeCode" margin=0]
	PermitType -> PermitDisplayTypeCode [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white"><TR><TD ALIGN="CENTER">hasDisplayType</TD></TR><TR><TD ALIGN="CENTER">1</TD></TR></TABLE>> arrowhead=normal style=solid]
	PermitGranteeTypeCode [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD BGCOLOR="lightgray" ALIGN="CENTER">PermitGranteeTypeCode</TD></TR></TABLE>> URL="../PermitGranteeTypeCode" margin=0]
	PermitType -> PermitGranteeTypeCode [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white"><TR><TD ALIGN="CENTER">hasGranteeType</TD></TR><TR><TD ALIGN="CENTER">0..1</TD></TR></TABLE>> arrowhead=normal style=solid]
	PermitType_uniqueLang_note [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD ALIGN="LEFT"><I>¹ Limited to one rdf:langString value per language</I></TD></TR></TABLE>> margin=0]
	PermitGranteeTypeCode -> PermitType_uniqueLang_note [style=invis]
}
