// Diagram for ImmobilizationEnforcementMethod
digraph {
	graph [overlap=false rankdir=TB splines=true]
	node [fontname=Arial fontsize=12 margin=0 shape=none]
	edge [fontname=Arial fontsize=11]
	{
		rank=source
		EnforcementMethod [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD BGCOLOR="lightgray" ALIGN="CENTER">EnforcementMethod</TD></TR></TABLE>> URL="../EnforcementMethod" margin=0]
	}
	ImmobilizationEnforcementMethod [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD BGCOLOR="lightgray" ALIGN="CENTER">ImmobilizationEnforcementMethod</TD></TR></TABLE>> URL="../ImmobilizationEnforcementMethod" margin=0]
	{
		rank=max
	}
	subgraph cluster_associated {
		label="" style=invis
		Invis [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD></TD></TR></TABLE>> margin=0 style=invis]
	}
	ImmobilizationEnforcementMethod -> EnforcementMethod [arrowhead=onormal style=solid]
}
