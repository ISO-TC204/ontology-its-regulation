    dcterms:license               <http://creativecommons.org/licenses/by/4.0/> ;
    dcterms:modified              "2026-07-28"^^xsd:date ;
    dcterms:title                 "ITS Ontology - Traffic Regulation Topic Area"@en ;
    its-core:draft                true ;
