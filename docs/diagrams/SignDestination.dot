// Diagram for SignDestination
digraph {
	graph [overlap=false rankdir=TB splines=true]
	node [fontname=Arial fontsize=12 margin=0 shape=none]
	edge [fontname=Arial fontsize=11]
	{
		rank=source
		RegulationThing [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD BGCOLOR="lightgray" ALIGN="CENTER">RegulationThing</TD></TR></TABLE>> URL="../RegulationThing" margin=0]
	}
	SignDestination [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD BGCOLOR="lightgray" ALIGN="CENTER">SignDestination</TD></TR><TR><TD ALIGN="LEFT">divergeName : rdf:langString</TD></TR><TR><TD ALIGN="LEFT">divergeRoute : rdf:langString</TD></TR></TABLE>> URL="../SignDestination" margin=0]
	{
		rank=max
	}
	subgraph cluster_associated {
		label="" style=invis
		Invis [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD></TD></TR></TABLE>> margin=0 style=invis]
		cdm1_Length [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD BGCOLOR="lightgray" ALIGN="CENTER">cdm1:Length</TD></TR></TABLE>> URL="https://w3id.org/citydata/part1/v1/Length" margin=0]
		DestinationPlace [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD BGCOLOR="lightgray" ALIGN="CENTER">DestinationPlace</TD></TR></TABLE>> URL="../DestinationPlace" margin=0]
		DestinationRoad [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD BGCOLOR="lightgray" ALIGN="CENTER">DestinationRoad</TD></TR></TABLE>> URL="../DestinationRoad" margin=0]
		Horizon [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD BGCOLOR="lightgray" ALIGN="CENTER">Horizon</TD></TR></TABLE>> URL="../Horizon" margin=0]
		OrdinalDirectionCode [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD BGCOLOR="lightgray" ALIGN="CENTER">OrdinalDirectionCode</TD></TR></TABLE>> URL="../OrdinalDirectionCode" margin=0]
	}
	SignDestination -> RegulationThing [arrowhead=onormal style=solid]
	SignDestination -> Invis [style=invis]
	Invis -> cdm1_Length [style=invis]
	cdm1_Length -> DestinationPlace [style=invis]
	DestinationPlace -> DestinationRoad [style=invis]
	DestinationRoad -> Horizon [style=invis]
	Horizon -> OrdinalDirectionCode [style=invis]
	OrdinalDirectionCode [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD BGCOLOR="lightgray" ALIGN="CENTER">OrdinalDirectionCode</TD></TR></TABLE>> URL="../OrdinalDirectionCode" margin=0]
	SignDestination -> OrdinalDirectionCode [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white"><TR><TD ALIGN="CENTER">arrowDirection</TD></TR></TABLE>> arrowhead=normal style=solid]
	Horizon [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD BGCOLOR="lightgray" ALIGN="CENTER">Horizon</TD></TR></TABLE>> URL="../Horizon" margin=0]
	SignDestination -> Horizon [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white"><TR><TD ALIGN="CENTER">destinationHorizon</TD></TR><TR><TD ALIGN="CENTER">0..1</TD></TR></TABLE>> arrowhead=normal style=solid]
	DestinationPlace [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD BGCOLOR="lightgray" ALIGN="CENTER">DestinationPlace</TD></TR></TABLE>> URL="../DestinationPlace" margin=0]
	SignDestination -> DestinationPlace [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white"><TR><TD ALIGN="CENTER">destinationPlace</TD></TR></TABLE>> arrowhead=normal style=solid]
	DestinationRoad [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD BGCOLOR="lightgray" ALIGN="CENTER">DestinationRoad</TD></TR></TABLE>> URL="../DestinationRoad" margin=0]
	SignDestination -> DestinationRoad [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white"><TR><TD ALIGN="CENTER">destinationRoad</TD></TR></TABLE>> arrowhead=normal style=solid]
	cdm1_Length [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD BGCOLOR="lightgray" ALIGN="CENTER">cdm1:Length</TD></TR></TABLE>> URL="https://w3id.org/citydata/part1/v1/Length" margin=0]
	SignDestination -> cdm1_Length [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white"><TR><TD ALIGN="CENTER">divergeHorizon</TD></TR></TABLE>> arrowhead=normal style=solid]
}
