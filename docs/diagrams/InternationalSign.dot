// Diagram for InternationalSign
digraph {
	graph [overlap=false rankdir=TB splines=true]
	node [fontname=Arial fontsize=12 margin=0 shape=none]
	edge [fontname=Arial fontsize=11]
	{
		rank=source
		"its-location_PointFeature" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD BGCOLOR="lightgray" ALIGN="CENTER">its-location:PointFeature</TD></TR></TABLE>> URL="https://w3id.org/itsdata/location/v1/PointFeature" margin=0]
		TrafficControlDevice [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD BGCOLOR="lightgray" ALIGN="CENTER">TrafficControlDevice</TD></TR></TABLE>> URL="../TrafficControlDevice" margin=0]
	}
	InternationalSign [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD BGCOLOR="lightgray" ALIGN="CENTER">InternationalSign</TD></TR><TR><TD ALIGN="LEFT">hasTextualRestriction [0..1]</TD></TR><TR><TD ALIGN="LEFT">nationalSignId : xsd:string [0..1]</TD></TR><TR><TD ALIGN="LEFT">pictogram : its-core:oidstring [1]</TD></TR></TABLE>> URL="../InternationalSign" margin=0]
	{
		rank=max
	}
	subgraph cluster_associated {
		label="" style=invis
		Invis [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD></TD></TR></TABLE>> margin=0 style=invis]
		Condition [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD BGCOLOR="lightgray" ALIGN="CENTER">Condition</TD></TR></TABLE>> URL="../Condition" margin=0]
		FeeSchedule [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD BGCOLOR="lightgray" ALIGN="CENTER">FeeSchedule</TD></TR></TABLE>> URL="../FeeSchedule" margin=0]
		i72_Measure [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD BGCOLOR="lightgray" ALIGN="CENTER">i72:Measure</TD></TR></TABLE>> URL="https://w3id.org/citydata/21972/v1/Measure" margin=0]
		RegulationContextCode [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD BGCOLOR="lightgray" ALIGN="CENTER">RegulationContextCode</TD></TR></TABLE>> URL="../RegulationContextCode" margin=0]
	}
	InternationalSign -> "its-location_PointFeature" [arrowhead=onormal style=solid]
	InternationalSign -> TrafficControlDevice [arrowhead=onormal style=solid]
	InternationalSign -> Invis [style=invis]
	Invis -> Condition [style=invis]
	Condition -> FeeSchedule [style=invis]
	FeeSchedule -> i72_Measure [style=invis]
	i72_Measure -> RegulationContextCode [style=invis]
	Condition [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD BGCOLOR="lightgray" ALIGN="CENTER">Condition</TD></TR></TABLE>> URL="../Condition" margin=0]
	InternationalSign -> Condition [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white"><TR><TD ALIGN="CENTER">hasCondition</TD></TR><TR><TD ALIGN="CENTER">0..1</TD></TR></TABLE>> arrowhead=normal style=solid]
	RegulationContextCode [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD BGCOLOR="lightgray" ALIGN="CENTER">RegulationContextCode</TD></TR></TABLE>> URL="../RegulationContextCode" margin=0]
	InternationalSign -> RegulationContextCode [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white"><TR><TD ALIGN="CENTER">hasContext</TD></TR></TABLE>> arrowhead=normal style=solid]
	FeeSchedule [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD BGCOLOR="lightgray" ALIGN="CENTER">FeeSchedule</TD></TR></TABLE>> URL="../FeeSchedule" margin=0]
	InternationalSign -> FeeSchedule [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white"><TR><TD ALIGN="CENTER">hasFeeSchedule</TD></TR><TR><TD ALIGN="CENTER">0..1</TD></TR></TABLE>> arrowhead=normal style=solid]
	i72_Measure [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD BGCOLOR="lightgray" ALIGN="CENTER">i72:Measure</TD></TR></TABLE>> URL="https://w3id.org/citydata/21972/v1/Measure" margin=0]
	InternationalSign -> i72_Measure [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white"><TR><TD ALIGN="CENTER">hasThreshold</TD></TR><TR><TD ALIGN="CENTER">0..1</TD></TR></TABLE>> arrowhead=normal style=solid]
	InternationalSign -> InternationalSign [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white"><TR><TD ALIGN="CENTER">hasComponentSign</TD></TR></TABLE>> arrowhead=normal style=solid]
}
