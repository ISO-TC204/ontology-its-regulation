:ReqView a owl:Ontology;
    # Ontology metadata
    dcterms:title                  "ReqView annotations for the ITS Traffic Regulations ontology.";
    skos:definition                "This ontology defines the identifiers used by ReqView to manage traceability and use of ontology concepts within ITS.";
    dcterms:license                "http://creativecommons.org/licenses/by/4.0/";
    dcterms:modified               "2026-08-26"^^xsd:date .


